# ==============================================================================
# 🚀 ALTRIX SCHOOL ERP SAAS — RAILWAY PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Paste these variables directly into Railway -> Project -> Service Settings -> "Raw Editor" / "Bulk Import"

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
APP_ENV=production
APP_NAME=AltRix School ERP API
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (on this VPS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DB_POOL_TYPE=queue
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 3. TOKEN SIGNING
# ------------------------------------------------------------------------------
# The secret this API signs and verifies its own JWTs with (HS256). The name is
# historical - nothing here talks to a hosted Supabase service; the database and
# the auth schema both live on this VPS. Renaming it would need a coordinated
# env change, so it stays.
# Generate with: openssl rand -hex 32
SUPABASE_JWT_SECRET=CHANGE_ME

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY were removed:
# no code reads them any more.

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (ALLOW PUBLIC DOMAINS & LOCALHOST FOR TESTING)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}},http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 5. REDIS (FOR WEBSOCKET REALTIME PUB/SUB & CACHING)
# If using Railway Redis Plugin, keep ${{Redis.REDIS_URL}}. Otherwise replace with your Redis URL.
# ------------------------------------------------------------------------------
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_POOL_SIZE=10
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# 6. AI AGENTS & LLM PROVIDERS
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
AI_API_KEY=CHANGE_ME
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_REASONING_MODEL=qwen3-coder-next
OLLAMA_GENERAL_MODEL=gemma3:12b

# ------------------------------------------------------------------------------
# 7. JAZZCASH PAYMENT GATEWAY
# ------------------------------------------------------------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/api/payments/jazzcash/callback
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# ------------------------------------------------------------------------------
# 8. RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASSWORD_RESET=5/5minutes
RATE_LIMIT_API=300/minute

# Optional: anchored regex for white-label tenant domains.
# NEVER set this to a shared hosting suffix such as .vercel.app or .railway.app:
# combined with credentialed CORS that lets anyone deploying there read your
# users authenticated responses.
CORS_ORIGIN_REGEX=

# ------------------------------------------------------------------------------
# 9. DATABASE BACKUPS
# ------------------------------------------------------------------------------
# A dump contains every student's personal data, so it is encrypted at rest.
# Generate with: python scripts/backup/restore.py genkey
# Keep a copy somewhere that survives losing this server, and NOT with the
# backups - without this key an encrypted dump cannot be restored.
# In production the backup refuses to run rather than write PII in the clear.
BACKUP_ENCRYPTION_KEY=CHANGE_ME

# Getting a copy off this server is always possible by downloading it from
# Super Admin > Backups & Recovery - no configuration needed. This only controls
# whether a second copy is ALSO made automatically.
#   none - download only
#   path - copy to BACKUP_MIRROR_PATH (another mounted disk, an NFS share, or a
#          directory something else syncs away). No credentials, nothing to expire.
#   s3   - any S3-compatible endpoint (needs boto3 in requirements.txt)
BACKUP_OFFSITE_TARGET=none
BACKUP_MIRROR_PATH=

# Only for BACKUP_OFFSITE_TARGET=s3
BACKUP_OFFSITE_BUCKET=altrix-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=

# Fallback alert address only. The real recipients are managed in
# Super Admin > Backups & Recovery, so they can be changed without a redeploy.
BACKUP_ALERT_EMAIL=

# ------------------------------------------------------------------------------
# 10. SCHEMA MIGRATIONS
# ------------------------------------------------------------------------------
# Schema DDL runs as a deploy step (python -m app.db_bootstrap), not on boot:
# the API, worker and beat containers all start together and would otherwise
# race each other for locks on the same tables. Leave empty for that behaviour.
RUN_STARTUP_DDL=
